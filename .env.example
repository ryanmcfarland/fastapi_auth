# Example environment variables for backend
# Copy this file to .env and fill in your actual values

SECRET_KEY = "your-big-secret-key"
ALGORITHM = "HS256"
# 1440 minutes = 24 hours, defaults below
ACCESS_TOKEN_EXPIRE_MINUTES = 1440
REFRESH_TOKEN_EXPIRE_DAYS = 365

DB_HOST=localhost
DB_NAME=app_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# .pgpass -> localhost:5432:app_db:your_db_user:your_db_password

LOG_DIRECTORY = "/path/to/your/logs"
LOG_LEVEL = "WARNING"
